# ============================================================
# BANDWIDTH-HERO PROXY — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------
# AUTHENTICATION & KEYS
# ------------------------------------------------------------
# Set at least one auth method. Without any, the server refuses to start.
API_KEY=your-secret-api-key-here
# USER_KEY=alternative-or-legacy-api-key
# LOGIN=your-username
# PASSWORD=your-password

# Allow API key in query string (NOT recommended — leaks in logs/browser history)
ALLOW_QUERY_API_KEY=true

# Internal relay key (Vercel <-> Cloudflare Worker)
INTERNAL_KEY=your-internal-key-here

# Service key for Cloudflare Worker to authenticate with Vercel
VERCEL_SERVICE_KEY=your-vercel-service-key-here

# ------------------------------------------------------------
# CACHE & PURGING
# ------------------------------------------------------------
# Appended to cache keys. Change this to instantly invalidate all cached images.
CACHE_VERSION=v1

# Secret key required to call the /purge endpoint to clear the cache manually.
PURGE_KEY=your-purge-secret-here

# Cloudflare API Token (Optional: used if the worker programmatically manages CF cache/DNS)
# CF_API_TOKEN=your-cloudflare-api-token

# ------------------------------------------------------------
# RATE LIMITING — Auth Failures (per IP)
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH_FAILURES=10

# ------------------------------------------------------------
# RATE LIMITING — Successful Requests (per IP)
# ------------------------------------------------------------
REQ_RATE_LIMIT_WINDOW_MS=60000
REQ_RATE_LIMIT_MAX=120

# ------------------------------------------------------------
# RATE LIMITING — Per-Key (Item 3)
# ------------------------------------------------------------
KEY_RATE_LIMIT_WINDOW_MS=60000
KEY_RATE_LIMIT_MAX=1200
SERVICE_KEY_RATE_LIMIT_MAX=0

# ------------------------------------------------------------
# DISTRIBUTED RATE LIMITING — Upstash Redis (optional)
# ------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
RATE_LIMIT_ADAPTER_TIMEOUT_MS=750
UPSTASH_CIRCUIT_FAILURE_THRESHOLD=5
UPSTASH_CIRCUIT_OPEN_MS=10000

# ------------------------------------------------------------
# IMAGE QUALITY & DIMENSIONS
# ------------------------------------------------------------
DEFAULT_QUALITY=40
MAX_QUALITY=100
MIN_QUALITY=10
MAX_OUTPUT_DIM=2560
MAX_STRIP_WIDTH=1600
DEFAULT_GRAYSCALE=false
ALLOW_ACCEPT_FALLBACK=false

# ------------------------------------------------------------
# MEMORY GOVERNOR
# ------------------------------------------------------------
MEMORY_CEILING_MB=1024
RSS_WALL_OFFSET_MB=25
RSS_ADMISSION_OFFSET_MB=60
PIXEL_MEMORY_DIVISOR=6
DOWNLOAD_BYTE_RATIO=0.35
DECOMPRESS_BYTE_RATIO=0.50

# ------------------------------------------------------------
# ADAPTIVE CONCURRENCY
# ------------------------------------------------------------
ENABLE_ADAPTIVE_CONCURRENCY=true
MAX_ACTIVE_REQUESTS=2
MAX_ACTIVE_ENCODES=1
MIN_ACTIVE_REQUESTS=1
MIN_ACTIVE_ENCODES=1
EVENT_LOOP_LAG_MS=150
CPU_PRESSURE_THRESHOLD_MS=50

# ------------------------------------------------------------
# UPSTREAM FETCH
# ------------------------------------------------------------
UPSTREAM_ACCEPT_ENCODING=identity
REQUEST_TIMEOUT_MS=8000
BODY_TIMEOUT_MS=20000
UPSTREAM_DEADLINE_MS=20000

# ------------------------------------------------------------
# CORRUPT IMAGE AUTO-RETRY
# ------------------------------------------------------------
ENABLE_CORRUPT_RETRY=true
MAX_DECODE_RETRIES=1

# ------------------------------------------------------------
# CLOUDFLARE WORKER RELAY (Vercel side)
# ------------------------------------------------------------
# Your Cloudflare Worker URL for relay fetching.
# CF_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# ------------------------------------------------------------
# IMAGE ENHANCEMENT TOGGLES
# ------------------------------------------------------------
ENABLE_JUDGE=true
ENABLE_DESKEW=false
ENABLE_MOIRE=false
ENABLE_LINE_DENOISE=false
ENABLE_BANDING_EXORCIST=true
ENABLE_ALPHA_SENTINEL=true
ENABLE_TEXT_PRESERVATION=false
ENABLE_HDR_CONVERSION=false
ENABLE_COLORSPACE_NORMALIZATION=true
ENABLE_GHOST_STRIPPER=false
ENABLE_LUMINANCE_FIX=false
ENABLE_SHARPEN=true
ENABLE_ALPHA_TRIM=false
ENABLE_METADATA_REAPER=true
ENABLE_SAFE_METADATA=true
ENABLE_MIRROR_RACING=false

# ------------------------------------------------------------
# IMAGE ENHANCEMENT LIMITS
# ------------------------------------------------------------
MAX_ANIMATION_FRAMES=1
AVIF_MAX_PIXELS=50000000
WEBP_MAX_PIXELS=50000000

# ------------------------------------------------------------
# VERCEL / DEPLOYMENT
# ------------------------------------------------------------
# Auto-set by Vercel. Do not override manually unless testing locally.
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_URL_= (Legacy/Override if Vercel's auto-injection fails)
